#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Valida o formato Conventional Commits: tipo(escopo): descrição
# Tipos aceitos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
MSG_FILE="$1"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9\-]+\))?!?: .+'

if ! grep -qE "$PATTERN" "$MSG_FILE"; then
  echo "❌ Commit fora do padrão Conventional Commits."
  echo "   Exemplos válidos:"
  echo "     feat(auth): add login form"
  echo "     fix(health): correct bmi rounding"
  echo "     chore: update deps"
  exit 1
fi